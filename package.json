{
  "name": "remotion-reels-starter",
  "version": "1.0.0",
  "description": "Automated short-video reel template for Remotion — data-driven 9:16 compositions for TikTok, Reels and Shorts",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "remotion",
    "video",
    "reels",
    "shorts",
    "tiktok",
    "9:16",
    "template",
    "react"
  ],
  "scripts": {
    "start": "remotion studio",
    "dev": "remotion studio",
    "build": "remotion render Reel out/reel.mp4 --codec=h264 --crf=16 --concurrency=50%",
    "build:launch": "remotion render ReelLaunch out/reel-launch.mp4 --codec=h264 --crf=16 --concurrency=50%",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
